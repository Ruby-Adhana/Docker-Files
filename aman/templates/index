<!DOCTYPE html>
<html>
<head>
    <title>MySQL Flask Dashboard</title>
</head>
<body>
    <h1>Welcome to the Flask MySQL App</h1>

    {% with messages = get_flashed_messages() %}
      {% if messages %}
        <ul>
        {% for msg in messages %}
          <li>{{ msg }}</li>
        {% endfor %}
        </ul>
      {% endif %}
    {% endwith %}

    <h2>Create New Database</h2>
    <form method="post" action="/create_database">
        <input type="text" name="database_name" placeholder="Database Name" required>
        <input type="submit" value="Create">
    </form>

    <h2>Create New Table</h2>
    <form method="post" action="/create_table">
        <input type="text" name="db_name" placeholder="Database Name" required>
        <input type="text" name="table_name" placeholder="Table Name" required>
        <input type="submit" value="Create Table">
    </form>

    <h2>All Databases</h2>
    {% if databases %}
        <ul>
        {% for db in databases %}
            <li>{{ db }}</li>
        {% endfor %}
        </ul>
    {% else %}
        <p><a href="/databases">Click here to load database list</a></p>
    {% endif %}
</body>
</html>

